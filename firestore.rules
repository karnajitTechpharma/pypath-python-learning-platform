rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    // Each learner can access only their own profile and learning records.
    match /users/{userId} {
      allow read, create, update: if signedInAs(userId);
      allow delete: if false;

      match /{collection}/{document=**} {
        allow read, create, update, delete: if signedInAs(userId)
          && collection in ['progress', 'notes', 'quizAttempts', 'activity'];
      }
    }

    // All other collections are closed unless an explicit rule is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

